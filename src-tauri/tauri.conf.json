{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naruto Old War Launcher",
  "version": "0.1.3",
  "identifier": "com.narutooldwar.launcher",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Naruto Old War Launcher",
        "width": 920,
        "height": 560,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
